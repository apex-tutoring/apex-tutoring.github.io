rules_version = '2';
// Apex Tutoring portal security rules.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// - Teachers are users whose UID has a document in /teachers (added by hand in the console).
// - Families can only read the students linked to their own account.
// - Only teachers can create or change anything.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    match /teachers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Maps a family email to its login account, so one family can have several students.
    match /families/{email} {
      allow read, write: if isTeacher();
    }

    match /students/{studentId} {
      allow read: if isTeacher() || (signedIn() && resource.data.familyUid == request.auth.uid);
      allow write: if isTeacher();

      match /updates/{updateId} {
        allow read: if isTeacher() || (signedIn() &&
          get(/databases/$(database)/documents/students/$(studentId)).data.familyUid == request.auth.uid);
        allow write: if isTeacher();
        // Families can only tick their homework as done / not done.
        allow update: if signedIn()
          && get(/databases/$(database)/documents/students/$(studentId)).data.familyUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['homeworkDone', 'homeworkDoneAt'])
          && request.resource.data.homeworkDone is bool
          && request.resource.data.homeworkDoneAt == request.time;
      }

      // Messages between the tutor and the family. Each side can only post as itself,
      // messages can't be edited, and only the tutor can delete them.
      match /messages/{messageId} {
        function isFamily() {
          return signedIn() && get(/databases/$(database)/documents/students/$(studentId)).data.familyUid == request.auth.uid;
        }
        function validMessage(from) {
          return request.resource.data.keys().hasOnly(['from', 'text', 'createdAt'])
            && request.resource.data.from == from
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
            && request.resource.data.createdAt == request.time;
        }
        allow read: if isTeacher() || isFamily();
        allow create: if (isTeacher() && validMessage('teacher')) || (isFamily() && validMessage('family'));
        allow delete: if isTeacher();
      }
    }

    // Reviews: one per family (document ID = their login ID). Families write their own,
    // which always resets to "waiting"; only the tutor can approve. Anyone can read approved ones.
    match /testimonials/{uid} {
      allow read: if resource.data.approved == true || isTeacher() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid && !isTeacher()
        && request.resource.data.keys().hasOnly(['name', 'rating', 'text', 'approved', 'createdAt'])
        && request.resource.data.approved == false
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 600
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.createdAt == request.time;
      allow update: if isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved']);
      allow delete: if isTeacher() || (signedIn() && request.auth.uid == uid);
    }

    // Website visitor stats: one document per day of plain counters (no personal data).
    // Anyone can add exactly 1 to a single counter; only the teacher can read them.
    function validCounter(k) { return k.matches('^[a-z0-9_]{1,40}$'); }
    match /stats/{day} {
      allow read: if isTeacher();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().size() == 1
        && validCounter(request.resource.data.keys()[0])
        && request.resource.data[request.resource.data.keys()[0]] == 1;
      allow update: if request.resource.data.keys().size() <= 40
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && validCounter(request.resource.data.diff(resource.data).affectedKeys().toList()[0])
        && request.resource.data[request.resource.data.diff(resource.data).affectedKeys().toList()[0]]
           == resource.data.get(request.resource.data.diff(resource.data).affectedKeys().toList()[0], 0) + 1;
    }
  }
}
